{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  // npm 12's --package-lock-only refuses registry tarballs of packages with
  // bundleDependencies (@tailwindcss/oxide-wasm32-wasi): npm/cli#9800.
  // npm 11 is also what the pinned Node bundles for CI and the image.
  constraints: { npm: "^11" },
  customManagers: [
    {
      // The Dockerfile takes the -tools image's mise from min_version.
      customType: "regex",
      description: "Track mise's min_version as the -tools image's mise",
      managerFilePatterns: ["/^\\.mise/config\\.toml$/"],
      matchStrings: ['min_version = "(?<currentValue>[^"]+)"'],
      datasourceTemplate: "docker",
      depNameTemplate: "jdxcode/mise",
    },
  ],
  packageRules: [
    {
      // The runner depends on how this mise behaves. CI runs the runner's
      // tests on it, but pull requests do not build the -tools image, so a
      // person merges each bump.
      description: "Hold the -tools image's mise for 3 days, bump it weekly and merge it by hand",
      matchDepNames: ["jdxcode/mise"],
      minimumReleaseAge: "3 days",
      schedule: ["* 0-3 * * 1"],
      automerge: false,
    },
  ],
}
