{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  constraints: { pnpm: "^12" },
  packageRules: [
    {
      description: "Group the -tools image's Hardened Images and gh and merge them by hand",
      matchDepNames: ["cli/cli", "jdxcode/mise", "registry.access.redhat.com/hi/core-runtime"],
      groupName: "image tools",
      groupSlug: "image-tools",
      automerge: false,
    },
  ],
}
