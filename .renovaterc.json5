{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["local>home-operations/.github:renovate-config"],
  postUpdateOptions: ["gomodTidy", "gomodUpdateImportPaths"],
  packageRules: [
    {
      description: "Group the -tools image's Hardened Images and gh and merge them by hand",
      matchDepNames: ["cli/cli", "registry.access.redhat.com/hi/core-runtime"],
      groupName: "image tools",
      groupSlug: "image-tools",
      automerge: false,
    },
  ],
}
